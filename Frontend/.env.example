# =====================================================================
# OpenPage Frontend Configuration
# Copy this to .env (for local development)
# For Vercel: Add these under Project Settings -> Environment Variables
# =====================================================================

# Backend API URL (Production: your Render web service URL, e.g. https://your-app.onrender.com)
# Local: http://localhost:5000 (or leave empty if using Vite dev proxy)
VITE_API_BASE_URL=http://localhost:5000

# Public Storefront URL (Production: your Vercel deployment URL, e.g. https://your-app.vercel.app)
# Local: http://localhost:5173
VITE_SITE_URL=http://localhost:5173

# Optional: Local Vite dev proxy target (only used during 'npm run dev')
VITE_DEV_API_PROXY=http://localhost:5000
