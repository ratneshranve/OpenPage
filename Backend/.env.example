# =====================================================================
# OpenPage API Configuration (.env.example)
# Copy this to .env (for local dev) or enter in Render Dashboard
# =====================================================================

# --- Core application ---
NODE_ENV=production
PORT=5000
APP_NAME=OpenPage

# Public storefront URL (Vercel URL in production, e.g. https://your-app.vercel.app)
FRONTEND_URL=https://your-app.vercel.app

# Public URL of this API (Render Web Service URL, e.g. https://your-backend.onrender.com)
API_BASE_URL=https://your-backend.onrender.com

# Canonical site URL for SEO (usually the same as FRONTEND_URL)
APP_BASE_URL=https://your-app.vercel.app

# Keep false when deploying frontend separately on Vercel
SERVE_FRONTEND=false

# Number of reverse proxies (1 for Render/Heroku/Cloudflare)
TRUST_PROXY=1

# Cookie SameSite setting:
# 'none' is REQUIRED when Frontend (Vercel) and Backend (Render) are on different domains
# 'lax' can be used if both are on the same custom domain or in local dev
COOKIE_SAME_SITE=none

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/openpage?retryWrites=true&w=majority

# --- Authentication and Security (Generate 32+ random characters each) ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_SECRET=
OTP_SECRET=
DOWNLOAD_TOKEN_SECRET=

OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
DOWNLOAD_LINK_TTL_MINUTES=60

# --- Razorpay (Required in production) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email Delivery (Option 1: Brevo HTTPS API for Render Free Tier, or Option 2: SMTP) ---
# For Render Free Tier, set BREVO_API_KEY (port 443 HTTPS, bypasses Render SMTP firewall):
BREVO_API_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ratneshranve@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=OpenPage
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_REPLY_TO=your-email@gmail.com

# --- File Storage (local, s3, or cloudinary) ---
# Note: Render free tier filesystem is ephemeral. Use s3 or cloudinary for persistent files!
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=openpage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_ASSETS_BASE_URL=
MAX_EBOOK_UPLOAD_MB=100
MAX_IMAGE_UPLOAD_MB=5

# --- Firebase Cloud Messaging (Optional push notifications) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# --- Marketing & Analytics (Optional) ---
META_PIXEL_ID=
META_PIXEL_ENABLED=false
GOOGLE_ADS_TAG_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_ADS_TRACKING_ENABLED=false
GOOGLE_ADSENSE_CLIENT_ID=
GOOGLE_ADSENSE_ENABLED=false

# --- Background Jobs & Rate Limiting ---
JOB_QUEUE_ENABLED=false
JOB_WORKERS_ENABLED=true
AUTOMATION_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600
LOG_LEVEL=info
