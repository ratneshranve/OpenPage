# =====================================================================
# OpenPage API configuration. Copy to .env and fill in.
# Secrets live ONLY here (or your host's secret manager), never in the DB
# or the frontend. Non-secret business settings are managed in the admin.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =====================================================================

# --- Core application ---
NODE_ENV=development
PORT=5000
APP_NAME=OpenPage
# Public storefront URL (used in emails, links, CORS)
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used for download and media links)
API_BASE_URL=http://localhost:5000
# Canonical site URL for SEO (sitemap, canonical tags). Usually the same as FRONTEND_URL.
APP_BASE_URL=http://localhost:5173
# Set true to serve Frontend/dist from this server with SEO meta tags injected per page.
SERVE_FRONTEND=false
# Number of reverse proxies in front of the API (for correct client IPs in rate limits)
TRUST_PROXY=1

# --- MongoDB ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/openpage

# --- Authentication and OTP (each secret: 32+ random characters) ---
JWT_SECRET=
SESSION_SECRET=
OTP_SECRET=
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Razorpay (Dashboard -> Account & Settings -> API keys / Webhooks) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: {API_BASE_URL}/api/v1/webhooks/razorpay
# Events: payment.captured, payment.failed, payment.authorized, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=

# --- SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=OpenPage
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=

# --- Private file storage ---
# local: files under Backend/storage (development only)
# s3:    any S3-compatible private bucket (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces)
# cloudinary: images as public uploads, eBooks as authenticated raw files (signed, expiring downloads).
#        Cloudinary's free plan limits raw files to 10 MB, so set MAX_EBOOK_UPLOAD_MB accordingly.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=openpage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Optional CDN/public URL that maps ONLY to the bucket's public/ prefix (cover images).
# Leave empty to serve images through {API_BASE_URL}/media/. Never point this at private/.
STORAGE_PUBLIC_ASSETS_BASE_URL=
DOWNLOAD_TOKEN_SECRET=
DOWNLOAD_LINK_TTL_MINUTES=60
MAX_EBOOK_UPLOAD_MB=100
MAX_IMAGE_UPLOAD_MB=5

# --- Firebase Cloud Messaging (optional browser notifications) ---
# Service account (server only):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Public web config (sent to browsers):
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# --- Meta Pixel (defaults; can be changed in Admin -> Integrations) ---
META_PIXEL_ID=
META_PIXEL_ENABLED=false

# --- Google Ads conversion tracking (defaults; can be changed in Admin -> Integrations) ---
GOOGLE_ADS_TAG_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_ADS_TRACKING_ENABLED=false

# --- Google AdSense (optional, separate from Google Ads) ---
GOOGLE_ADSENSE_CLIENT_ID=
GOOGLE_ADSENSE_ENABLED=false

# --- Automation and jobs ---
# OpenPage uses a built-in durable MongoDB queue; Redis is not required.
REDIS_URL=
JOB_QUEUE_ENABLED=false
JOB_WORKERS_ENABLED=true
EMAIL_RETRY_LIMIT=5
EMAIL_RETRY_DELAY_SECONDS=60
AUTOMATION_ENABLED=true

# --- Security and operations ---
# Extra allowed browser origins, comma separated (FRONTEND_URL is always allowed)
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600
LOG_LEVEL=info
